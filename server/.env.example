# Server only. Never put an OpenAI key in Flutter or --dart-define.
OPENAI_API_KEY=
PORT=8787
# Your HTTPS token-validation endpoint, returning {"sub":"verified-user-id"}.
AUTH_USERINFO_URL=
# Exact browser origin allowed to call this server, no wildcard.
ALLOWED_ORIGIN=http://localhost:7357
# Development only; forces the server to bind to 127.0.0.1.
ALLOW_LOCAL_DEMO=false
